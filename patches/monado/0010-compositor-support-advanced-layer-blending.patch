From 2ac018fdab237869d6d8929423b55a0d7c16a5df Mon Sep 17 00:00:00 2001
From: galister <85970-galister@users.noreply.gitlab.freedesktop.org>
Date: Wed, 29 Jul 2026 20:28:14 +0900
Subject: [PATCH 1/1] implement XR_FB_composition_layer_alpha_blend in renderer

---
 src/xrt/compositor/render/render_interface.h  |  16 ++-
 src/xrt/compositor/shaders/layer.comp         | 103 +++++++++++++++---
 .../compositor/shaders/layer_defines.inc.glsl |   8 ++
 src/xrt/compositor/util/comp_render_cs.c      |   2 +
 src/xrt/compositor/util/comp_render_helpers.h |  19 +++-
 5 files changed, 131 insertions(+), 17 deletions(-)

diff --git a/src/xrt/compositor/render/render_interface.h b/src/xrt/compositor/render/render_interface.h
index 466341c7f..4376482bb 100644
--- a/src/xrt/compositor/render/render_interface.h
+++ b/src/xrt/compositor/render/render_interface.h
@@ -1199,6 +1199,17 @@ struct render_chroma_key_info
 	float despill;
 };
 
+/*!
+ * Advanced blend factors sent to the compute layer shader.
+ */
+struct render_advanced_blend_info
+{
+	uint32_t src_factor_color;
+	uint32_t dst_factor_color;
+	uint32_t src_factor_alpha;
+	uint32_t dst_factor_alpha;
+};
+
 /*!
  * UBO data that is sent to the compute layer shaders.
  *
@@ -1231,10 +1242,13 @@ struct render_compute_layer_ubo_data
 		{
 			uint32_t layer_type;
 			uint32_t unpremultiplied_alpha;
+			uint32_t advanced_blending;
 			uint32_t _padding0;
-			uint32_t _padding1;
 		} layer_data;
 
+		//! Advanced blend factors.
+		struct render_advanced_blend_info advanced_blend;
+
 		/*!
 		 * Which image/sampler(s) correspond to each layer.
 		 *
diff --git a/src/xrt/compositor/shaders/layer.comp b/src/xrt/compositor/shaders/layer.comp
index 01f921bf0..ebb13e358 100644
--- a/src/xrt/compositor/shaders/layer.comp
+++ b/src/xrt/compositor/shaders/layer.comp
@@ -19,10 +19,18 @@ struct layer_data
 {
 	uint layer_type;
 	uint unpremultiplied_alpha;
+	uint advanced_blending;
 
 	// This struct is used in an array, gets padded to vec4.
 	uint _padding0;
-	uint _padding1;
+};
+
+struct advanced_blend_info
+{
+	uint src_factor_color;
+	uint dst_factor_color;
+	uint src_factor_alpha;
+	uint dst_factor_alpha;
 };
 
 struct image_info
@@ -68,6 +76,9 @@ struct Layer {
 	// Per-layer data.
 	layer_data layer_data;
 
+	// Advanced blend factors.
+	advanced_blend_info advanced_blend;
+
 	// which image/sampler(s) correspond to each layer
 	image_info image_info;
 
@@ -213,8 +224,10 @@ vec2 transform_uv(vec2 uv, uint layer)
 	}
 }
 
-vec4 do_cylinder(vec2 view_uv, uint layer)
+vec4 do_cylinder(vec2 view_uv, uint layer, out bool covered)
 {
+	covered = false;
+
 	// Get ray position in model space.
 	const vec3 ray_origin = (LAYER.mv_inverse * vec4(0, 0, 0, 1)).xyz;
 
@@ -297,6 +310,8 @@ vec4 do_cylinder(vec2 view_uv, uint layer)
 	const float ymax = height / 2;
 
 	if (y < ymax && y > ymin && lon < uhan && lon > lhan) {
+		covered = true;
+
 		// map configured display region to whole texture
 		vec2 offset = vec2(lhan, ymin);
 		vec2 extent = vec2(uhan - lhan, ymax - ymin);
@@ -318,8 +333,10 @@ vec4 do_cylinder(vec2 view_uv, uint layer)
 	return out_color;
 }
 
-vec4 do_equirect2(vec2 view_uv, uint layer)
+vec4 do_equirect2(vec2 view_uv, uint layer, out bool covered)
 {
+	covered = false;
+
 	// Get ray position in model space.
 	const vec3 ray_origin = (LAYER.mv_inverse * vec4(0, 0, 0, 1)).xyz;
 
@@ -396,6 +413,8 @@ vec4 do_equirect2(vec2 view_uv, uint layer)
 	const float lvan = lower_vertical_angle / PI + 0.5f;
 
 	if (lat < uvan && lat > lvan && lon < uhan && lon > lhan) {
+		covered = true;
+
 		// map configured display region to whole texture
 		vec2 ll_offset = vec2(lhan, lvan);
 		vec2 ll_extent = vec2(uhan - lhan, uvan - lvan);
@@ -417,13 +436,23 @@ vec4 do_equirect2(vec2 view_uv, uint layer)
 	return out_color;
 }
 
-vec4 do_projection(vec2 view_uv, uint layer)
+vec4 do_projection(vec2 view_uv, uint layer, out bool covered)
 {
 	uint source_image_index = LAYER.image_info.color_image_index;
 
 	// Do any transformation needed.
 	vec2 uv = transform_uv(view_uv, layer);
 
+	// A projection layer only covers its normalized sub-image rectangle.
+	vec2 rect_a = LAYER.post_transform.xy;
+	vec2 rect_b = rect_a + LAYER.post_transform.zw;
+	vec2 rect_min = min(rect_a, rect_b);
+	vec2 rect_max = max(rect_a, rect_b);
+	covered = all(greaterThanEqual(uv, rect_min)) && all(lessThanEqual(uv, rect_max));
+	if (!covered) {
+		return vec4(0.0);
+	}
+
 	// Sample the source.
 	vec4 colour = vec4(texture(source[source_image_index], uv).rgba);
 
@@ -449,8 +478,10 @@ vec3 get_direction(vec2 uv)
 	return direction;
 }
 
-vec4 do_quad(vec2 view_uv, uint layer)
+vec4 do_quad(vec2 view_uv, uint layer, out bool covered)
 {
+	covered = false;
+
 	uint source_image_index = LAYER.image_info.color_image_index;
 
 	// center point of the plane in view space.
@@ -508,6 +539,8 @@ vec4 do_quad(vec2 view_uv, uint layer)
 			intersection_ps.y <= LAYER.quad_extent.y / 2.;
 
 		if (in_plane_bounds) {
+			covered = true;
+
 			// intersection_ps is in [-quad_extent .. quad_extent]. Transform to  [0 .. quad_extent], then scale to [ 0 .. 1 ] for sampling
 			vec2 plane_uv = (intersection_ps.xy + LAYER.quad_extent / 2.) / LAYER.quad_extent;
 
@@ -529,6 +562,26 @@ vec4 do_quad(vec2 view_uv, uint layer)
 	return vec4(colour);
 }
 
+float get_blend_factor(uint factor, float src_alpha, float dst_alpha)
+{
+	switch (factor) {
+	case LAYER_BLEND_FACTOR_ZERO:
+		return 0.0;
+	case LAYER_BLEND_FACTOR_ONE:
+		return 1.0;
+	case LAYER_BLEND_FACTOR_SRC_ALPHA:
+		return src_alpha;
+	case LAYER_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA:
+		return 1.0 - src_alpha;
+	case LAYER_BLEND_FACTOR_DST_ALPHA:
+		return dst_alpha;
+	case LAYER_BLEND_FACTOR_ONE_MINUS_DST_ALPHA:
+		return 1.0 - dst_alpha;
+	default:
+		return 0.0;
+	}
+}
+
 vec4 do_layers(vec2 view_uv)
 {
 	vec4 accum = vec4(0, 0, 0, 0);
@@ -536,35 +589,55 @@ vec4 do_layers(vec2 view_uv)
 	int layer_count = ubo.layer_count.x;
 	for (uint layer = 0; layer < layer_count; layer++) {
 		vec4 rgba = vec4(0, 0, 0, 0);
+		bool covered = false;
 
 		switch (LAYER.layer_data.layer_type) {
 		case LAYER_COMP_TYPE_QUAD:
-			rgba = do_quad(view_uv, layer);
+			rgba = do_quad(view_uv, layer, covered);
 			break;
 		case LAYER_COMP_TYPE_CYLINDER:
-			rgba = do_cylinder(view_uv, layer);
+			rgba = do_cylinder(view_uv, layer, covered);
 			break;
 		case LAYER_COMP_TYPE_EQUIRECT2:
-			rgba = do_equirect2(view_uv, layer);
+			rgba = do_equirect2(view_uv, layer, covered);
 			break;
 		case LAYER_COMP_TYPE_PROJECTION:
-			rgba = do_projection(view_uv, layer);
+			rgba = do_projection(view_uv, layer, covered);
 			rgba = apply_chroma_key(rgba, layer);
 			break;
 		default: break;
 		}
 
+		// Layers that don't cover this pixel must not participate in blending
+		if (!covered) {
+			continue;
+		}
+
 		// Apply color scale and bias
 		rgba = clamp(rgba * LAYER.color_scale + LAYER.color_bias, 0.0, 1.0);
 
-		if (LAYER.layer_data.unpremultiplied_alpha != 0) {
-			// Unpremultipled blend factor of src.a.
-			accum.rgb = mix(accum.rgb, rgba.rgb, rgba.a);
+		if (LAYER.layer_data.advanced_blending != 0) {
+			float src_factor_color =
+				get_blend_factor(LAYER.advanced_blend.src_factor_color, rgba.a, accum.a);
+			float dst_factor_color =
+				get_blend_factor(LAYER.advanced_blend.dst_factor_color, rgba.a, accum.a);
+			float src_factor_alpha =
+				get_blend_factor(LAYER.advanced_blend.src_factor_alpha, rgba.a, accum.a);
+			float dst_factor_alpha =
+				get_blend_factor(LAYER.advanced_blend.dst_factor_alpha, rgba.a, accum.a);
+
+			accum.rgb = rgba.rgb * src_factor_color + accum.rgb * dst_factor_color;
+			accum.a = rgba.a * src_factor_alpha + accum.a * dst_factor_alpha;
 		} else {
-			// Premultiplied blend factor of 1.
-			accum.rgb = (accum.rgb * (1 - rgba.a)) + rgba.rgb;
+			if (LAYER.layer_data.unpremultiplied_alpha != 0) {
+				// Unpremultipled blend factor of src.a.
+				accum.rgb = mix(accum.rgb, rgba.rgb, rgba.a);
+			} else {
+				// Premultiplied blend factor of 1.
+				accum.rgb = (accum.rgb * (1 - rgba.a)) + rgba.rgb;
+			}
+			accum.a = fma((1.f - rgba.a), accum.a, rgba.a);
 		}
-		accum.a = fma((1.f - rgba.a), accum.a, rgba.a);
 	}
 
 	return accum;
diff --git a/src/xrt/compositor/shaders/layer_defines.inc.glsl b/src/xrt/compositor/shaders/layer_defines.inc.glsl
index 9f601c7e3..5305a19e8 100644
--- a/src/xrt/compositor/shaders/layer_defines.inc.glsl
+++ b/src/xrt/compositor/shaders/layer_defines.inc.glsl
@@ -19,4 +19,12 @@
 //! Maps to XRT_LAYER_PROJECTION[_DEPTH] (not numerically)
 #define LAYER_COMP_TYPE_PROJECTION 4
 
+//! These values must match enum xrt_blend_factor.
+#define LAYER_BLEND_FACTOR_ZERO 0
+#define LAYER_BLEND_FACTOR_ONE 1
+#define LAYER_BLEND_FACTOR_SRC_ALPHA 2
+#define LAYER_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA 3
+#define LAYER_BLEND_FACTOR_DST_ALPHA 4
+#define LAYER_BLEND_FACTOR_ONE_MINUS_DST_ALPHA 5
+
 #endif // LAYER_DEFINES_INC_GLSL
diff --git a/src/xrt/compositor/util/comp_render_cs.c b/src/xrt/compositor/util/comp_render_cs.c
index ff7313f6f..a6764e277 100644
--- a/src/xrt/compositor/util/comp_render_cs.c
+++ b/src/xrt/compositor/util/comp_render_cs.c
@@ -703,6 +703,8 @@ comp_render_cs_layer(struct render_compute *render,
 
 		ubo_data->layers[cur_layer].layer_data.layer_type = xrt_layer_to_cs_layer_type(data);
 		ubo_data->layers[cur_layer].layer_data.unpremultiplied_alpha = is_layer_unpremultiplied(data);
+		apply_advanced_blend_from_layer(data, &ubo_data->layers[cur_layer].layer_data.advanced_blending,
+		                                &ubo_data->layers[cur_layer].advanced_blend);
 
 		apply_bias_and_scale_from_layer(data, &ubo_data->layers[cur_layer].color_scale,
 		                                &ubo_data->layers[cur_layer].color_bias);
diff --git a/src/xrt/compositor/util/comp_render_helpers.h b/src/xrt/compositor/util/comp_render_helpers.h
index 043d93045..9adf7564d 100644
--- a/src/xrt/compositor/util/comp_render_helpers.h
+++ b/src/xrt/compositor/util/comp_render_helpers.h
@@ -31,7 +31,8 @@ extern "C" {
 static inline VkImageView
 get_image_view(const struct comp_swapchain_image *image, enum xrt_layer_composition_flags flags, uint32_t array_index)
 {
-	if (flags & XRT_LAYER_COMPOSITION_BLEND_TEXTURE_SOURCE_ALPHA_BIT) {
+	if (flags &
+	    (XRT_LAYER_COMPOSITION_BLEND_TEXTURE_SOURCE_ALPHA_BIT | XRT_LAYER_COMPOSITION_ADVANCED_BLENDING_BIT)) {
 		return image->views.alpha[array_index];
 	}
 
@@ -147,6 +148,22 @@ apply_bias_and_scale_from_layer(const struct xrt_layer_data *data,
 	}
 }
 
+static inline void
+apply_advanced_blend_from_layer(const struct xrt_layer_data *data,
+                                uint32_t *out_advanced_blending,
+                                struct render_advanced_blend_info *out_advanced_blend)
+{
+	*out_advanced_blending = (data->flags & XRT_LAYER_COMPOSITION_ADVANCED_BLENDING_BIT) != 0;
+	if (*out_advanced_blending == 0) {
+		return;
+	}
+
+	out_advanced_blend->src_factor_color = data->advanced_blend.src_factor_color;
+	out_advanced_blend->dst_factor_color = data->advanced_blend.dst_factor_color;
+	out_advanced_blend->src_factor_alpha = data->advanced_blend.src_factor_alpha;
+	out_advanced_blend->dst_factor_alpha = data->advanced_blend.dst_factor_alpha;
+}
+
 
