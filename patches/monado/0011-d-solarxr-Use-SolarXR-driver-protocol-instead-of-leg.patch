+	                    .battery_level = (uint8_t)(charge * 100.f),
+	                    .charging = charging,
+	                },
+	        },
+	};
+
+	solarxr_ipc_message_write_single(head, end, (const uint8_t *)&update_tracker_battery_packet,
+	                                 sizeof(update_tracker_battery_packet));
+}
