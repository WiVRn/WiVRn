From 36f259e15e0c77a478dcbc124a444582dc7520a9 Mon Sep 17 00:00:00 2001
From: Jonathan Steffan <jsteffan@fedoraproject.org>
Date: Sun, 23 Aug 2026 16:41:06 -0600
Subject: [PATCH 1/1] c/null: make the frame rate configurable

The null compositor's frame interval was fixed at 20 FPS, and the refresh
rate it advertises is derived from it. Expose it as XRT_COMPOSITOR_NULL_FPS
so a headless consumer can drive the compositor at a rate representative of
the HMD it stands in for. The default is unchanged.
---
 src/xrt/compositor/null/null_compositor.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/xrt/compositor/null/null_compositor.c b/src/xrt/compositor/null/null_compositor.c
index 30779967c..b3aec8081 100644
--- a/src/xrt/compositor/null/null_compositor.c
+++ b/src/xrt/compositor/null/null_compositor.c
@@ -43,6 +43,7 @@ static const uint64_t MAX_VIEW_WIDTH = 1920;
 static const uint64_t MAX_VIEW_HEIGHT = 1080;
 
 DEBUG_GET_ONCE_LOG_OPTION(log, "XRT_COMPOSITOR_LOG", U_LOGGING_INFO)
+DEBUG_GET_ONCE_NUM_OPTION(fps, "XRT_COMPOSITOR_NULL_FPS", 20)
 
 
 /*
@@ -614,7 +615,7 @@ null_compositor_create_system(struct xrt_device *xdev, struct xrt_system_composi
 	c->settings.log_level = debug_get_log_option_log();
 	c->frame.waited.id = -1;
 	c->frame.rendering.id = -1;
-	c->settings.frame_interval_ns = U_TIME_1S_IN_NS / 20; // 20 FPS
+	c->settings.frame_interval_ns = U_TIME_1S_IN_NS / debug_get_num_option_fps();
 	c->xdev = xdev;
 
 	NULL_DEBUG(c, "Doing init %p", (void *)c);
-- 
