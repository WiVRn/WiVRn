 }
 
-vec4 do_projection_uv(vec2 view_uv, uint layer, out vec2 out_uv)
+vec4 do_projection_uv(vec2 view_uv, uint layer, out vec2 out_uv, out bool covered)
 {
 	uint source_image_index = LAYER.image_info.color_image_index;
 
@@ -431,10 +448,10 @@ vec4 do_projection_uv(vec2 view_uv, uint layer, out vec2 out_uv)
 	out_uv = view_uv;
 
 	// Reject coordinates outside the view frustum.
-	bool in_frustum_bounds =
+	covered =
 		all(greaterThanEqual(view_uv, vec2(0.0))) &&
 		all(lessThan(view_uv, vec2(1.0)));
-	if (!in_frustum_bounds) {
+	if (!covered) {
