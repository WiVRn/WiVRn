 	vec2 negative_edges = smoothstep(0, k_inset_blend_edge, uv);
 	vec2 positive_edges = smoothstep(1.0, 1.0 - k_inset_blend_edge, uv);
@@ -460,10 +480,10 @@ vec4 do_projection_inset(vec2 view_uv, uint layer, out float out_inset_blend_fac
 	return colour;
 }
 
