 {
+	covered = false;
+
 	// Get ray position in model space.
 	const vec3 ray_origin = (LAYER.mv_inverse * vec4(0, 0, 0, 1)).xyz;
 
@@ -295,6 +306,8 @@ vec4 do_cylinder(vec2 view_uv, uint layer)
 	const float ymax = height / 2;
 
 	if (y < ymax && y > ymin && lon < uhan && lon > lhan) {
