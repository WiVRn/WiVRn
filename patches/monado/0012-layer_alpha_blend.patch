+
 		// map configured display region to whole texture
 		vec2 offset = vec2(lhan, ymin);
 		vec2 extent = vec2(uhan - lhan, ymax - ymin);
@@ -316,8 +329,10 @@ vec4 do_cylinder(vec2 view_uv, uint layer)
