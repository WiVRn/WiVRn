 	}
 
@@ -450,7 +467,10 @@ vec4 do_projection_uv(vec2 view_uv, uint layer, out vec2 out_uv)
 vec4 do_projection_inset(vec2 view_uv, uint layer, out float out_inset_blend_factor)
 {
