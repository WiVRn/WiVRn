index 3c79eef8b..501ededc9 100644
--- a/src/xrt/drivers/solarxr/feeder.c
+++ b/src/xrt/drivers/solarxr/feeder.c
@@ -44,8 +44,12 @@ feeder_add_device(struct feeder *const feeder, struct xrt_device *const xdev)
 
 	bool result = false;
 	if (!solarxr_ipc_socket_is_connected(&feeder->socket) &&
-	    !solarxr_ipc_socket_connect(&feeder->socket,
-	                                solarxr_ipc_socket_find(feeder->socket.log_level, "SlimeVRInput"))) {
+	    !solarxr_ipc_socket_connect(
+	        &feeder->socket,
+	        solarxr_ipc_socket_find(
+	            feeder->socket.log_level,
+	            "SlimeVRDriver"))) // FIXME: change this back to SlimeVRInput when server side is fixed
