#version 460
#extension GL_KHR_shader_subgroup_basic: require
#extension GL_KHR_shader_subgroup_shuffle_relative: require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#define MAX_DIM 4097
#define MAX_SAMPLES 4
// taps of two pixels each an axis for blocks wider than MAX_SAMPLES (covers 16 pixels whole)
#define MAX_TAPS 8

layout(set = 0, binding = 0) uniform sampler2D source[2];
layout(set = 0, binding = 1, std430) buffer restrict Config
{
	// foveation parameters
	uint x[2*MAX_DIM];
	uint y[2*MAX_DIM];
} ubo;

layout(set = 0, binding = 2) uniform writeonly restrict image2DArray luma;
layout(set = 0, binding = 3) uniform writeonly restrict image2DArray chroma;

layout(constant_id = 0) const int alpha_width = 0;
// vr-server: the levels of a stored value (255 at 8 bits, 1023 at 10); 0 = no dither
layout(constant_id = 1) const float levels = 0;

// vr-server: a value that falls between two levels is stored as the upper one in a share of
// the pixels equal to its fraction (an ordered 4x4 pattern), not rounded. A block's mean
// keeps its brightness whatever the block's size: with plain rounding a game's dither of
// 75.25 came out as 75 where a block held 2x2 or 4x4 pixels and as a pattern of 75 and 76
// where it held 1 or 3x3, in bands to the left and right of the middle.
const float bayer[16] = float[16](
	 0,  8,  2, 10,
	12,  4, 14,  6,
	 3, 11,  1,  9,
	15,  7, 13,  5);
float dither(uint x, uint y)
{
	if (levels == 0)
		return 0;
	// within +-15/32 of a level: a value already on a level stays there
	return ((bayer[(y % 4) * 4 + (x % 4)] + 0.5) / 16 - 0.5) / levels;
}

const mat3 color_space = mat3(
//         R        G        B
/* Y */ 0.2126,  0.7152,  0.0722,
/* Cb*/-0.1146, -0.3854,  0.5,
/* Cr*/ 0.5   , -0.4542, -0.0458);

vec3 rgb_to_ycbcr(vec3 color)
{
	return transpose(color_space) * color + vec3(0, 0.5, 0.5);
}

float from_linear_to_srgb_channel(float value)
{
	if (value < 0.0031308) {
		return 12.92 * value;
	} else {
		return 1.055 * pow(value, 1.0 / 2.4) - 0.055;
	}
}

vec3 from_linear_to_srgb(vec3 linear_rgb)
{
	return vec3(
		from_linear_to_srgb_channel(linear_rgb.r),
		from_linear_to_srgb_channel(linear_rgb.g),
		from_linear_to_srgb_channel(linear_rgb.b)
	);
}

uint ABfe(uint src,uint off,uint bits){return bitfieldExtract(src,int(off),int(bits));}
uint ABfiM(uint src,uint ins,uint bits){return bitfieldInsert(src,ins,0,int (bits));}
 // More complex remap 64x1 to 8x8 which is necessary for 2D wave reductions.
 //  543210
 //  ======
 //  .xx..x
 //  y..yy.
 // Details,
 //  LANE TO 8x8 MAPPING
 //  ===================
 //  00 01 08 09 10 11 18 19
 //  02 03 0a 0b 12 13 1a 1b
 //  04 05 0c 0d 14 15 1c 1d
 //  06 07 0e 0f 16 17 1e 1f
 //  20 21 28 29 30 31 38 39
 //  22 23 2a 2b 32 33 3a 3b
 //  24 25 2c 2d 34 35 3c 3d
 //  26 27 2e 2f 36 37 3e 3f
 uint ARmpRed8x8_x(uint a){return ABfiM(ABfe(a,2u,3u),a,1u);}
 uint ARmpRed8x8_y(uint a){return ABfiM(ABfe(a,3u,3u),ABfe(a,1u,2u),2u);}
 //uvec2 ARmpRed8x8(uint32_t a){return uvec2(ABfiM(ABfe(a,2u,3u),a,1u),ABfiM(ABfe(a,3u,3u),ABfe(a,1u,2u),2u));}

void main()
{
	uint iz = gl_GlobalInvocationID.z;

	// In order to know how subgroup are mapped, we have to do the swizzling ourselves
	// in the work group.
	uint id = gl_SubgroupID * gl_SubgroupSize + gl_SubgroupInvocationID;
	uint iy = gl_WorkGroupID.y * gl_WorkGroupSize.y + ARmpRed8x8_y(id);
	uint ix = gl_WorkGroupID.x * gl_WorkGroupSize.x + ARmpRed8x8_x(id);

	uint ymin = ubo.y[MAX_DIM * iz + iy];
	uint ymax = ubo.y[MAX_DIM * iz + iy + 1];
	if (ymin > ymax)
	{
		uint tmp = ymin;
		ymin = ymax;
		ymax = tmp;
	}

	uint xmin = ubo.x[MAX_DIM * iz + ix];
	uint xmax = ubo.x[MAX_DIM * iz + ix + 1];

	// vr-server: every source pixel of the block counts. The block was sampled at
	// MAX_SAMPLES points an axis, a stride apart: with a block of 5 to 8 pixels that is every
	// second pixel, always the same phase of a pattern two pixels wide (a game's dither), so
	// the squeezed part of the picture came out at another brightness than the middle, where
	// a pixel is a pixel (seen: luma 75.0 around a square of 75.8 on a plain colour).
	// Up to MAX_SAMPLES pixels an axis are still read one by one; a wider block is read by
	// taps of the linear sampler, each halfway between two pixels (their mean), side by side.
	uint xn = xmax - xmin;
	uint yn = ymax - ymin;
	uint xtaps = xn <= MAX_SAMPLES ? xn : min((xn + 1) / 2, MAX_TAPS);
	uint ytaps = yn <= MAX_SAMPLES ? yn : min((yn + 1) / 2, MAX_TAPS);
	vec2 texel = 1.0 / vec2(textureSize(source[iz], 0));

	vec4 colour = vec4(0);
	for (uint j = 0; j < ytaps; ++j) {
		// the middle of the j-th of ytaps equal parts of the block
		float y = float(ymin) + (float(j) + 0.5) * float(yn) / float(ytaps);
		for (uint i = 0; i < xtaps; ++i) {
			float x = float(xmin) + (float(i) + 0.5) * float(xn) / float(xtaps);
			colour += textureLod(source[iz], vec2(x, y) * texel, 0);
		}
	}
	colour /= max(xtaps * ytaps, 1);
	colour.xyz = rgb_to_ycbcr(from_linear_to_srgb(colour.rgb));

	imageStore(luma, ivec3(ix, iy, iz), vec4(colour.x + dither(ix, iy)));

	vec4 sum = colour + subgroupShuffleDown(colour, 1) + subgroupShuffleDown(colour, 2) + subgroupShuffleDown(colour, 3);

	if ((id % 4)== 0)
	{
		// actual chroma
		imageStore(chroma, ivec3(ix/2, iy/2, iz), vec4(sum.y, sum.z, 0, 0) / 4 + dither(ix/2, iy/2));

		if (alpha_width > 0)
		{
			// alpha in luma
			int offset = alpha_width * int(iz);
			imageStore(luma, ivec3(offset + ix/2, iy/2, 2), vec4(sum.w, 0, 0, 0) / 4);
			imageStore(chroma, ivec3(offset + ix/2, iy/2, 2), vec4(0.5, 0.5, 0, 0));
		}
	}
}
