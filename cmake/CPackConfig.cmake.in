set(GIT_TAG "@GIT_TAG@")
set(GIT_DESC "@GIT_DESC@")
set(GIT_EXECUTABLE "@GIT_EXECUTABLE@")


if (NOT (GIT_TAG OR GIT_DESC))
	execute_process(
		COMMAND ${GIT_EXECUTABLE} describe --exact-match --tags
		OUTPUT_VARIABLE GIT_TAG
		OUTPUT_STRIP_TRAILING_WHITESPACE
		ERROR_QUIET
	)
endif()


if (GIT_TAG)
	string(REGEX REPLACE "^v" "" CPACK_APK_VERSION_NAME "${GIT_TAG}")
else()

	if (NOT GIT_DESC)
		execute_process(
			COMMAND ${GIT_EXECUTABLE} describe --tags --always
			OUTPUT_VARIABLE GIT_DESC
			OUTPUT_STRIP_TRAILING_WHITESPACE
			ERROR_QUIET
		)
	endif()

	string(REGEX REPLACE "^v" "" CPACK_APK_VERSION_NAME "${GIT_DESC}")
endif()

set(CPACK_PACKAGE_VERSION ${CPACK_APK_VERSION_NAME})
set(CPACK_PACKAGE_FILE_NAME "wivrn")
