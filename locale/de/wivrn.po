msgstr "Der Server erlaubt keine weitergeleiteten Eingabegeräte"

#: client/scenes/gui_settings.cpp:613
msgctxt "setting name"
msgid "Hand tracking"
msgstr "Hand-Tracking"

#: client/scenes/gui_settings.cpp:613
msgid "Track your hands for input when controllers are down."
