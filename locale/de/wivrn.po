#: client/scenes/gui_settings.cpp:616
msgctxt "setting name"
msgid "Eye tracking"
msgstr "Eye-Tracking"

#: client/scenes/gui_settings.cpp:616
msgid "Used by foveated encoding to focus quality where you look."
msgstr ""
"Wird von foveierter Kodierung genutzt, um die Qualität dorthin zu "
