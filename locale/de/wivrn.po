msgctxt "tooltip for disabled settings"
msgid "Disconnect to change this setting."
msgstr "Trenne die Verbindung, um diese Einstellung zu ändern."

#: client/scenes/gui_settings.cpp:220
msgid "Refresh rate"
msgstr "Bildwiederholrate"

#: client/scenes/gui_settings.cpp:221
msgid ""
"Select refresh rate based on measured application performance. May cause "
"flicker when a change happens."
msgstr ""
"Wähle die Bildwiederholrate anhand der gemessenen Anwendungsleistung. Kann "
"bei einer Änderung Flackern verursachen."

#: client/scenes/gui_settings.cpp:244
msgctxt "automatic refresh rate"
msgid "Auto"
msgstr "Auto"

#: client/scenes/gui_settings.cpp:257
msgid "Render resolution"
msgstr "Renderauflösung"

#: client/scenes/gui_settings.cpp:258
#, c++-format
msgctxt "render resolution"
msgid "Pixels rendered per eye ({}x{}). Lower to gain performance."
msgstr "Gerenderte Pixel pro Auge ({}x{}). Verringern für mehr Leistung."

#: client/scenes/gui_settings.cpp:273
msgid "Foveated encoding"
msgstr "Foveated Encoding"

#: client/scenes/gui_settings.cpp:275
msgid ""
"Higher values focus image quality where you look at, improving latency, "
"power efficiency and quality."
msgstr ""
"Höhere Werte fokussieren die Bildqualität dorthin, wo du hinsiehst, und "
"verbessern Latenz, Energieeffizienz und Qualität."

#: client/scenes/gui_settings.cpp:276
msgid ""
"Higher values focus image quality at the center, improving latency, power "
"efficiency and quality."
msgstr ""
"Höhere Werte fokussieren die Bildqualität im Zentrum und verbessern Latenz, "
"Energieeffizienz und Qualität."

#: client/scenes/gui_settings.cpp:296
msgid "Application SpaceWarp"
msgstr "Application SpaceWarp"

#: client/scenes/gui_settings.cpp:297
msgid "Renders at half the refresh rate. The headset may synthesise frames."
msgstr ""
"Rendert mit der halben Bildwiederholrate. Das Headset kann Frames "
"synthetisieren."

#: client/scenes/gui_settings.cpp:303
msgid "Set a refresh rate other than auto to enable this setting."
msgstr ""
"Setze eine andere Bildwiederholrate als Auto, um diese Einstellung zu "
"aktivieren."

#: client/scenes/gui_settings.cpp:311
msgid "High power mode"
msgstr "Höchstleistungsmodus"

#: client/scenes/gui_settings.cpp:312
msgid ""
"Increase power usage to allow higher resolution and refresh rate. Drains "
"battery and runs hot."
msgstr ""
"Erhöht die Stromaufnahme für höhere Auflösung und Bildwiederholrate. "
"Verbraucht Akku und wird heiß."

#: client/scenes/gui_settings.cpp:320
msgctxt "page header title"
msgid "Performance"
msgstr "Leistung"

#: client/scenes/gui_settings.cpp:320
msgctxt "page header subtitle"
msgid "Frame rate, resolution and power draw."
msgstr "Bildrate, Auflösung und Stromverbrauch."

#: client/scenes/gui_settings.cpp:332 client/scenes/gui_settings.cpp:344
msgctxt "Codec"
msgid "Automatic"
msgstr "Automatisch"

#: client/scenes/gui_settings.cpp:336
msgctxt "Codec"
msgid "H.264"
msgstr "H.264"

#: client/scenes/gui_settings.cpp:338
msgctxt "Codec"
msgid "HEVC (H.265)"
msgstr "HEVC (H.265)"

#: client/scenes/gui_settings.cpp:340
msgctxt "Codec"
msgid "AV1"
msgstr "AV1"

#: client/scenes/gui_settings.cpp:354 client/scenes/gui_settings.cpp:372
msgctxt "setting name"
msgid "Video codec"
msgstr "Video-Codec"

#: client/scenes/gui_settings.cpp:355
msgid "How video is compressed before it is sent to the headset."
msgstr ""
"Wie das Video komprimiert wird, bevor es an das Headset gesendet wird."

#: client/scenes/gui_settings.cpp:382
msgctxt "setting name"
msgid "10-bit color"
msgstr "10-bit-Farben"

#: client/scenes/gui_settings.cpp:383
msgid "Higher color precision, supported by HEVC and AV1."
msgstr "Höhere Farbgenauigkeit, unterstützt von HEVC und AV1."

#: client/scenes/gui_settings.cpp:396
msgid "Bitrate"
msgstr "Bitrate"

#: client/scenes/gui_settings.cpp:397
msgid "Video data rate sent to the headset."
msgstr "An das Headset gesendete Videodatenrate."

#: client/scenes/gui_settings.cpp:412
msgid "Adjust bitrate with thumbstick"
msgstr "Bitrate mit Thumbstick anpassen"

#: client/scenes/gui_settings.cpp:413
msgid "Use the right thumbstick to fine-tune the bitrate."
msgstr "Nutze den rechten Thumbstick, um die Bitrate fein einzustellen."

#: client/scenes/gui_settings.cpp:415
msgctxt "button label to adjust the bitrate"
msgid "Adjust"
msgstr "Anpassen"

#: client/scenes/gui_settings.cpp:425
msgctxt "setting name"
msgid "Foveation center override"
msgstr "Override des Foveationszentrums"

#: client/scenes/gui_settings.cpp:426
msgid ""
"Manually set where image quality is focused, instead of the center or your "
"gaze."
msgstr ""
"Lege manuell fest, wo die Bildqualität fokussiert wird, statt im Zentrum "
"oder am Blickpunkt."

#: client/scenes/gui_settings.cpp:438
msgctxt "setting name"
msgid "Foveation center"
msgstr "Foveation-Zentrum"

#: client/scenes/gui_settings.cpp:439
#, c++-format
msgid "Height {:.1f} °, distance {:.2f} m"
msgstr "Höhe {:.1f} °, Abstand {:.2f} m"

#: client/scenes/gui_settings.cpp:441
msgctxt "button label to change the foveation center"
msgid "Change"
msgstr "Ändern"

#: client/scenes/gui_settings.cpp:444
msgid "Enable foveation center override to change this setting."
msgstr ""
"Aktiviere die Foveation-Zentrum-Übersteuerung, um diese Einstellung zu "
"ändern."

#: client/scenes/gui_settings.cpp:450
msgctxt "setting name"
msgid "In-stream window"
msgstr "Fenster im Stream"

#: client/scenes/gui_settings.cpp:451
msgid ""
"Enables the configuration window to be shown while the game is streaming. If"
" enabled, the window is activated by pressing both thumbsticks."
msgstr ""
"Zeigt das Konfigurationsfenster während des Streamings an. Wenn aktiviert, "
"wird das Fenster durch Drücken beider Thumbsticks aktiviert."

#: client/scenes/gui_settings.cpp:458
msgctxt "page header title"
msgid "Streaming"
msgstr "Streaming"

#: client/scenes/gui_settings.cpp:458
msgctxt "page header subtitle"
msgid "How video is encoded and sent to the headset."
msgstr "Wie das Video kodiert und an das Headset gesendet wird."

#: client/scenes/gui_settings.cpp:474
msgctxt "openxr_post_processing"
msgid "Normal"
msgstr "Normal"

#: client/scenes/gui_settings.cpp:477
msgctxt "openxr_post_processing"
msgid "Quality"
msgstr "Qualität"

#: client/scenes/gui_settings.cpp:479
msgctxt "openxr_post_processing"
msgid "Disabled"
msgstr "Deaktiviert"

#: client/scenes/gui_settings.cpp:508
msgid "Supersampling"
msgstr "Supersampling"

#: client/scenes/gui_settings.cpp:508
msgid ""
"Reduce flicker for high contrast edges. Useful when the input resolution is "
"high compared to the headset display."
msgstr ""
"Reduziert Flackern an kontrastreichen Kanten. Nützlich, wenn die "
"Eingangsauflösung hoch im Vergleich zum Headset-Display ist."

#: client/scenes/gui_settings.cpp:509
msgid "Sharpening"
msgstr "Bildschärfung"

#: client/scenes/gui_settings.cpp:509
msgid ""
"Improve clarity of high contrast edges and counteract blur. Useful when the "
"input resolution is low compared to the headset display."
msgstr ""
"Verbessert die Klarheit kontrastreicher Kanten und verringert Unschärfe. "
"Nützlich, wenn die Eingangsauflösung niedrig im Vergleich zum Headset-"
"Display ist."

#: client/scenes/gui_settings.cpp:512
msgid "Post-processing"
msgstr "Post-Processing"

#: client/scenes/gui_settings.cpp:512
msgctxt "page header subtitle"
msgid "OpenXR layer supersampling and sharpening."
msgstr "OpenXR-Layer-Supersampling und -Schärfung."

#: client/scenes/gui_settings.cpp:524
msgctxt "setting name"
msgid "Microphone"
msgstr "Mikrofon"

#: client/scenes/gui_settings.cpp:525
msgid "Stream the headset microphone to the PC."
msgstr "Streamet das Headset-Mikrofon an den PC."

#: client/scenes/gui_settings.cpp:536
msgctxt "setting name"
msgid "Unprocessed audio"
msgstr "Unverarbeitetes Audio"

#: client/scenes/gui_settings.cpp:537
msgid "Force disable audio filters, such as noise cancellation."
msgstr "Deaktiviert Audiofilter wie Geräuschunterdrückung."

#: client/scenes/gui_settings.cpp:546
msgctxt "page header title"
msgid "Audio"
msgstr "Audio"

#: client/scenes/gui_settings.cpp:546
msgctxt "page header subtitle"
msgid "Microphone streamed to the PC."
msgstr "An den PC gestreamtes Mikrofon."

#: client/scenes/gui_settings.cpp:557
msgctxt "setting name"
msgid "Keyboard"
msgstr "Tastatur"

#: client/scenes/gui_settings.cpp:558
msgid "Forward the keyboard from the headset to the PC."
msgstr "Leitet die Tastatur vom Headset an den PC weiter."

#: client/scenes/gui_settings.cpp:567
msgctxt "setting name"
msgid "Mouse"
msgstr "Maus"

#: client/scenes/gui_settings.cpp:568
msgid "Forward the mouse from the headset to the PC."
msgstr "Leitet die Maus vom Headset an den PC weiter."

#: client/scenes/gui_settings.cpp:577
msgctxt "setting name"
msgid "Gamepad"
msgstr "Gamepad"

#: client/scenes/gui_settings.cpp:578
msgid "Forward the gamepad from the headset to the PC."
msgstr "Leitet das Gamepad vom Headset an den PC weiter."

#: client/scenes/gui_settings.cpp:585
msgctxt "page header title"
msgid "Devices"
msgstr "Geräte"

#: client/scenes/gui_settings.cpp:585
msgctxt "page header subtitle"
msgid "Forward input devices to the PC."
msgstr "Leitet Eingabegeräte an den PC weiter."

#: client/scenes/gui_settings.cpp:589 client/scenes/stream_network.cpp:91
