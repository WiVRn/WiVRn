msgctxt "setting name"
msgid "Video codec"
msgstr "Codec video"

#: client/scenes/gui_settings.cpp:356
msgid "How video is compressed before it is sent to the headset."
msgstr "Come viene compresso il video prima che sia inviato al visore."

#: client/scenes/gui_settings.cpp:378
msgctxt "setting name"
msgid "10-bit color"
msgstr "Colore a 10 bit"

#: client/scenes/gui_settings.cpp:379
msgid "Higher color precision, supported by HEVC and AV1."
msgstr "Maggiore precisione di colore, supportato da HEVC e AV1."

#: client/scenes/gui_settings.cpp:392
msgid "Bitrate"
msgstr "Velocità di trasmissione"

#: client/scenes/gui_settings.cpp:393
msgid "Video data rate sent to the headset."
msgstr "Bitrate video inviato al visore."

#: client/scenes/gui_settings.cpp:408
msgctxt "setting name"
msgid "Foveation center override"
msgstr "Sovrascrittura centro di foveazione"

#: client/scenes/gui_settings.cpp:409
msgid ""
"Manually set where image quality is focused, instead of the center or your "
"gaze."
msgstr ""
"Imposta manualmente dove viene concentrata la qualità dell'immagine, invece ch"
"e al "
"centro o dove stai guardando."

#: client/scenes/gui_settings.cpp:421
msgctxt "setting name"
msgid "Foveation center"
msgstr "Centro di foveazione"

#: client/scenes/gui_settings.cpp:422
#, c++-format
msgid "Height {:.1f} °, distance {:.2f} m"
msgstr "Altezza {:.1f} °, distanza {:.2f} m"

#: client/scenes/gui_settings.cpp:424
msgctxt "button label to change the foveation center"
msgid "Change"
msgstr "Cambia"

#: client/scenes/gui_settings.cpp:427
msgid "Enable foveation center override to change this setting."
msgstr ""
"Abilita la sovrascrittura centro di foveazione per modificare questa impostazi"
"one."

#: client/scenes/gui_settings.cpp:431
msgctxt "page header title"
msgid "Streaming"
msgstr "Streaming"

#: client/scenes/gui_settings.cpp:431
msgctxt "page header subtitle"
msgid "How video is encoded and sent to the headset."
msgstr "Come il video viene codificato e inviato al visore."

#: client/scenes/gui_settings.cpp:436
msgctxt "confirmation messagebox title"
msgid "Disable in-stream window"
msgstr "Disattiva finestra nello stream"

#: client/scenes/gui_settings.cpp:437
msgctxt "confirmation message"
msgid ""
"Do you really want to disable the in-stream window?\n"
"You will not be able to re-open it with the thumbsticks."
msgstr ""
"Vuoi davvero disabilitare la finestra nello stream?\n"
"Non sarà possibile riaprirla utilizzando le levette analogiche."

#: client/scenes/gui_settings.cpp:438 client/scenes/lobby_gui.cpp:867
msgid "Yes"
msgstr "Sì"

#: client/scenes/gui_settings.cpp:439 client/scenes/lobby_gui.cpp:874
msgid "No"
msgstr "No"

#: client/scenes/gui_settings.cpp:460
msgctxt "openxr_post_processing"
msgid "Normal"
msgstr "Normale"

#: client/scenes/gui_settings.cpp:463
msgctxt "openxr_post_processing"
msgid "Quality"
msgstr "Qualità"

#: client/scenes/gui_settings.cpp:465
msgctxt "openxr_post_processing"
msgid "Disabled"
msgstr "Disattivato"

#: client/scenes/gui_settings.cpp:490
msgid "Supersampling"
msgstr "Supersampling"

#: client/scenes/gui_settings.cpp:490
msgid ""
"Reduce flicker for high contrast edges. Useful when the input resolution is "
"high compared to the headset display."
msgstr ""
"Riduce lo sfarfallio sui bordi ad alto contrasto. Utile quando la risoluzione "
"di input "
"è elevata rispetto a quella dello schermo del visore."

#: client/scenes/gui_settings.cpp:491
msgid "Sharpening"
msgstr "Miglioramento della nitidezza"

#: client/scenes/gui_settings.cpp:491
msgid ""
"Improve clarity of high contrast edges and counteract blur. Useful when the "
"input resolution is low compared to the headset display."
msgstr ""
"Migliora la nitidezza dei bordi ad alto contrasto e contrasta l'effetto sfocat"
"o. Utile quando la "
"risoluzione di input è bassa rispetto a quella dello schermo del visore."

#: client/scenes/gui_settings.cpp:494
msgid "Post-processing"
msgstr "Post-trattamento"

#: client/scenes/gui_settings.cpp:494
msgctxt "page header subtitle"
msgid "OpenXR layer supersampling and sharpening."
msgstr "Supersampling e nitidezza dei layer OpenXR."

#: client/scenes/gui_settings.cpp:507
msgctxt "setting name"
msgid "Microphone"
msgstr "Microfono"

#: client/scenes/gui_settings.cpp:508
msgid "Stream the headset microphone to the PC."
