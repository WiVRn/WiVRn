msgid "Application SpaceWarp"
msgstr "SpaceWarp da Aplicação"

#: client/scenes/gui_settings.cpp:289
msgid "Renders at half the refresh rate. The headset may synthesise frames."
msgstr "Renderiza na metade da taxa de atualização. O headset pode sintetizar quadros."

