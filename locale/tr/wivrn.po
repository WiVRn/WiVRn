msgctxt "Codec"
msgid "H.264"
msgstr "H.264"

#: client/scenes/gui_settings.cpp:338
msgctxt "Codec"
msgid "HEVC (H.265)"
msgstr "HEVC (H.265)"

#: client/scenes/gui_settings.cpp:340
msgctxt "Codec"
msgid "AV1"
msgstr "AV1"

