msgid "Disconnect to change this setting."
msgstr "Déconnectez-vous pour modifier ce paramètre."

#: client/scenes/gui_settings.cpp:233
msgid "Refresh rate"
msgstr "Taux de rafraîchissement"

#: client/scenes/gui_settings.cpp:234
msgid ""
"Use 'auto' to select the refresh rate based on measured application "
"performance. May cause flicker when a change happens."
msgstr ""
"Utilisez 'auto' pour choisir la fréquence de rafraîchissement en fonction "
"des performances mesurées. Peut causer des clignotements lors du changement "
"de fréquence."

#: client/scenes/gui_settings.cpp:257
msgctxt "automatic refresh rate, use a short string"
msgid "Auto"
msgstr "Auto"

#: client/scenes/gui_settings.cpp:270
msgid "Render resolution"
msgstr "Définition de rendu"

#: client/scenes/gui_settings.cpp:271
#, c++-format
msgctxt "render resolution"
msgid "Pixels rendered per eye ({}x{}). Lower to gain performance."
msgstr ""
"Pixels rendus par œil ({}x{}). Diminuez cette valeur pour améliorer les "
"performances."

#: client/scenes/gui_settings.cpp:288
msgid "Application SpaceWarp"
msgstr "Application SpaceWarp"

#: client/scenes/gui_settings.cpp:289
msgid "Renders at half the refresh rate. The headset may synthesise frames."
msgstr ""
"Effectue le rendu à la moitié du taux de rafraîchissement. Le casque peut "
"générer des images."

#: client/scenes/gui_settings.cpp:295
msgid "Set a refresh rate other than auto to enable this setting."
msgstr ""
"Choisissez un taux de rafraîchissement autre que auto pour activer ce "
"paramètre."

#: client/scenes/gui_settings.cpp:299
msgctxt "page header title"
msgid "Video"
msgstr "Vidéo"

#: client/scenes/gui_settings.cpp:299
msgctxt "page header subtitle"
msgid "Frame rate and resolution."
msgstr "Taux de rafraîchissement et résolution."

#: client/scenes/gui_settings.cpp:312
msgid "Foveated encoding"
msgstr "Fovéation d'encodage"

#: client/scenes/gui_settings.cpp:314
msgid ""
"Higher values focus image quality where you look at, improving latency, "
"power efficiency and quality."
msgstr ""
"Une plus grande valeur permet d'optimiser la qualité de l'image où vous "
"regardez, en améliorant la latence, l'efficacité énergétique et la qualité."

#: client/scenes/gui_settings.cpp:315
msgid ""
"Higher values focus image quality at the center, improving latency, power "
"efficiency and quality."
msgstr ""
"Une plus grande valeur permet d'optimiser la qualité de l'image au centre, "
"en améliorant la latence, l'efficacité énergétique et la qualité."

#: client/scenes/gui_settings.cpp:333 client/scenes/gui_settings.cpp:345
msgctxt "Codec"
msgid "Automatic"
msgstr "Automatique"

#: client/scenes/gui_settings.cpp:337
msgctxt "Codec"
msgid "H.264"
msgstr "H.264"

#: client/scenes/gui_settings.cpp:339
msgctxt "Codec"
msgid "HEVC (H.265)"
msgstr "HEVC (H.265)"

#: client/scenes/gui_settings.cpp:341
msgctxt "Codec"
msgid "AV1"
msgstr "AV1"

