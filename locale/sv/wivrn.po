#: client/scenes/gui_settings.cpp:945
msgctxt "setting name"
msgid "Panel opacity"
msgstr "Panelernas opacitet"

#: client/scenes/gui_settings.cpp:945
msgctxt "setting description"
msgid "Opacity of the panel and card backgrounds"
msgstr "Opacitet för panelernas och kortens bakgrunder"

