#: client/scenes/gui_settings.cpp:223 client/scenes/gui_settings.cpp:311
#: client/scenes/gui_settings.cpp:506 client/scenes/gui_settings.cpp:588
msgctxt "tooltip for disabled settings"
msgid "Disconnect to change this setting."
msgstr "Koppla från för att ändra den här inställningen."

#: client/scenes/gui_settings.cpp:234
msgid "Refresh rate"
msgstr "Uppdateringsfrekvens"

#: client/scenes/gui_settings.cpp:236
msgid ""
"WiVRn can't directly change the refresh rate on this device. See your "
"device's settings to change the refresh rate."
msgstr ""
"WiVRn kan inte ändra uppdateringsfrekvensen direkt på den här enheten. Ändra"
" den i enhetens inställningar."

#: client/scenes/gui_settings.cpp:237
msgid ""
"Use 'auto' to select the refresh rate based on measured application "
"performance. May cause flicker when a change happens."
msgstr ""
"Välj ”Auto” för att anpassa uppdateringsfrekvensen efter programmets "
"uppmätta prestanda. Bilden kan flimra när frekvensen ändras."

#: client/scenes/gui_settings.cpp:260
msgctxt "automatic refresh rate, use a short string"
msgid "Auto"
msgstr "Auto"

#: client/scenes/gui_settings.cpp:274
msgid "Render resolution"
msgstr "Renderingsupplösning"

#: client/scenes/gui_settings.cpp:275
#, c++-format
msgctxt "render resolution"
msgid "Pixels rendered per eye ({}x{}). Lower to gain performance."
msgstr ""
"Antal bildpunkter som renderas per öga ({}x{}). Sänk värdet för bättre "
"prestanda."

#: client/scenes/gui_settings.cpp:292
msgid "Application SpaceWarp"
msgstr "Application SpaceWarp"

#: client/scenes/gui_settings.cpp:293
msgid "Renders at half the refresh rate. The headset may synthesise frames."
msgstr ""
"Renderar med halva uppdateringsfrekvensen. Headsetet kan generera extra "
"bildrutor."

#: client/scenes/gui_settings.cpp:299
msgid "Set a refresh rate other than auto to enable this setting."
msgstr ""
"Välj en annan uppdateringsfrekvens än Auto för att aktivera den här "
"inställningen."

#: client/scenes/gui_settings.cpp:303
msgctxt "page header title"
msgid "Video"
msgstr "Video"

#: client/scenes/gui_settings.cpp:303
msgctxt "page header subtitle"
msgid "Frame rate and resolution."
msgstr "Bildfrekvens och upplösning."

#: client/scenes/gui_settings.cpp:316
msgid "Foveated encoding"
msgstr "Foveerad kodning"

#: client/scenes/gui_settings.cpp:318
msgid ""
"Higher values focus image quality where you look at, improving latency, "
"power efficiency and quality."
msgstr ""
"Högre värden koncentrerar bildkvaliteten till området du tittar på, vilket "
"minskar fördröjningen och strömförbrukningen samt förbättrar kvaliteten."

#: client/scenes/gui_settings.cpp:319
msgid ""
"Higher values focus image quality at the center, improving latency, power "
"efficiency and quality."
msgstr ""
"Högre värden koncentrerar bildkvaliteten till mitten, vilket minskar "
"fördröjningen och strömförbrukningen samt förbättrar kvaliteten."

#: client/scenes/gui_settings.cpp:337 client/scenes/gui_settings.cpp:349
msgctxt "Codec"
msgid "Automatic"
msgstr "Automatisk"

#: client/scenes/gui_settings.cpp:341
msgctxt "Codec"
msgid "H.264"
msgstr "H.264"

#: client/scenes/gui_settings.cpp:343
msgctxt "Codec"
msgid "HEVC (H.265)"
msgstr "HEVC (H.265)"

#: client/scenes/gui_settings.cpp:345
msgctxt "Codec"
msgid "AV1"
msgstr "AV1"

#: client/scenes/gui_settings.cpp:359 client/scenes/gui_settings.cpp:372
msgctxt "setting name"
msgid "Video codec"
msgstr "Videokodek"

#: client/scenes/gui_settings.cpp:360
msgid "How video is compressed before it is sent to the headset."
msgstr "Hur videon komprimeras innan den skickas till headsetet."

#: client/scenes/gui_settings.cpp:382
msgctxt "setting name"
msgid "10-bit color"
msgstr "10-bitars färg"

#: client/scenes/gui_settings.cpp:383
msgid "Higher color precision, supported by HEVC and AV1."
msgstr "Högre färgprecision. Stöds av HEVC och AV1."

#: client/scenes/gui_settings.cpp:396
msgid "Bitrate"
msgstr "Bithastighet"

#: client/scenes/gui_settings.cpp:397
msgid "Video data rate sent to the headset."
msgstr "Mängden videodata som skickas till headsetet per sekund."

#: client/scenes/gui_settings.cpp:412
msgctxt "setting name"
msgid "Foveation center override"
msgstr "Ange foveeringens centrum manuellt"

#: client/scenes/gui_settings.cpp:413
msgid ""
"Manually set where image quality is focused, instead of the center or your "
"gaze."
msgstr ""
"Välj manuellt var bildkvaliteten ska koncentreras, i stället för i mitten "
"eller där du tittar."

#: client/scenes/gui_settings.cpp:425
msgctxt "setting name"
msgid "Foveation center"
msgstr "Foveeringens centrum"

#: client/scenes/gui_settings.cpp:426
#, c++-format
msgid "Height {:.1f} °, distance {:.2f} m"
msgstr "Höjd {:.1f} °, avstånd {:.2f} m"

#: client/scenes/gui_settings.cpp:428
msgctxt "button label to change the foveation center"
msgid "Change"
msgstr "Ändra"

#: client/scenes/gui_settings.cpp:431
msgid "Enable foveation center override to change this setting."
msgstr ""
"Aktivera manuellt val av foveeringens centrum för att ändra den här "
"inställningen."

#: client/scenes/gui_settings.cpp:435
msgctxt "page header title"
msgid "Streaming"
msgstr "Strömning"

#: client/scenes/gui_settings.cpp:435
msgctxt "page header subtitle"
msgid "How video is encoded and sent to the headset."
msgstr "Hur videon kodas och skickas till headsetet."

#: client/scenes/gui_settings.cpp:440
msgctxt "confirmation messagebox title"
msgid "Disable in-stream window"
msgstr "Inaktivera fönstret under strömning"

#: client/scenes/gui_settings.cpp:441
msgctxt "confirmation message"
msgid ""
"Do you really want to disable the in-stream window?\n"
"You will not be able to re-open it with the thumbsticks."
msgstr ""
"Vill du verkligen inaktivera fönstret under strömning?\n"
"Du kommer inte att kunna öppna det igen med styrspakarna."

#: client/scenes/gui_settings.cpp:442 client/scenes/lobby_gui.cpp:886
msgid "Yes"
msgstr "Ja"

#: client/scenes/gui_settings.cpp:443 client/scenes/lobby_gui.cpp:893
msgid "No"
msgstr "Nej"

#: client/scenes/gui_settings.cpp:464
msgctxt "openxr_post_processing"
msgid "Normal"
msgstr "Normal"

#: client/scenes/gui_settings.cpp:467
msgctxt "openxr_post_processing"
msgid "Quality"
msgstr "Kvalitet"

#: client/scenes/gui_settings.cpp:469
msgctxt "openxr_post_processing"
msgid "Disabled"
msgstr "Inaktiverad"

#: client/scenes/gui_settings.cpp:494
msgid "Supersampling"
msgstr "Supersampling"

#: client/scenes/gui_settings.cpp:494
msgid ""
"Reduce flicker for high contrast edges. Useful when the input resolution is "
"high compared to the headset display."
msgstr ""
"Minskar flimmer längs kanter med hög kontrast. Användbart när "
"indataupplösningen är hög jämfört med headsetets skärm."

#: client/scenes/gui_settings.cpp:495
msgid "Sharpening"
msgstr "Skärpeförbättring"

#: client/scenes/gui_settings.cpp:495
msgid ""
"Improve clarity of high contrast edges and counteract blur. Useful when the "
"input resolution is low compared to the headset display."
msgstr ""
"Gör kanter med hög kontrast tydligare och motverkar oskärpa. Användbart när "
"indataupplösningen är låg jämfört med headsetets skärm."

#: client/scenes/gui_settings.cpp:498
msgid "Post-processing"
msgstr "Efterbehandling"

#: client/scenes/gui_settings.cpp:498
msgctxt "page header subtitle"
msgid "OpenXR layer supersampling and sharpening."
msgstr "Supersampling och skärpeförbättring av OpenXR-lager."

#: client/scenes/gui_settings.cpp:511
msgctxt "setting name"
msgid "Microphone"
msgstr "Mikrofon"

#: client/scenes/gui_settings.cpp:512
msgid "Stream the headset microphone to the PC."
msgstr "Strömma ljud från headsetets mikrofon till datorn."

#: client/scenes/gui_settings.cpp:524
msgctxt "setting name"
msgid "Unprocessed audio"
msgstr "Obehandlat ljud"

#: client/scenes/gui_settings.cpp:525
msgid "Disable audio filters, such as noise cancellation."
msgstr "Inaktivera ljudfilter, till exempel brusreducering."

#: client/scenes/gui_settings.cpp:535
msgctxt "page header title"
msgid "Audio"
msgstr "Ljud"

#: client/scenes/gui_settings.cpp:535
msgctxt "page header subtitle"
msgid "Microphone streamed to the PC."
msgstr "Mikrofonljud som strömmas till datorn."

#: client/scenes/gui_settings.cpp:548
msgctxt "setting name"
msgid "Keyboard"
msgstr "Tangentbord"

#: client/scenes/gui_settings.cpp:549
msgid "Forward the keyboard from the headset to the PC."
msgstr "Vidarebefordra tangentbordsinmatning från headsetet till datorn."

#: client/scenes/gui_settings.cpp:558
msgctxt "setting name"
msgid "Mouse"
msgstr "Mus"

#: client/scenes/gui_settings.cpp:559
msgid "Forward the mouse from the headset to the PC."
msgstr "Vidarebefordra musinmatning från headsetet till datorn."

#: client/scenes/gui_settings.cpp:569
msgctxt "setting name"
msgid "Gamepad"
msgstr "Spelkontroll"

#: client/scenes/gui_settings.cpp:570
msgid "Forward the gamepad from the headset to the PC."
msgstr "Vidarebefordra spelkontrollens inmatning från headsetet till datorn."

#: client/scenes/gui_settings.cpp:577
msgctxt "page header title"
msgid "Devices"
msgstr "Enheter"

#: client/scenes/gui_settings.cpp:577
msgctxt "page header subtitle"
msgid "Forward input devices to the PC."
msgstr "Vidarebefordra inmatningsenheter till datorn."

#: client/scenes/gui_settings.cpp:581 client/scenes/stream_network.cpp:91
msgid "The server does not allow forwarded input devices"
msgstr "Servern tillåter inte vidarebefordrade inmatningsenheter"

#: client/scenes/gui_settings.cpp:597
msgctxt "setting name"
msgid "Posture"
msgstr "Kroppsställning"

#: client/scenes/gui_settings.cpp:598
msgid "Posture assumed when a stream connects."
msgstr "Kroppsställning som förutsätts när strömningen startar."

#: client/scenes/gui_settings.cpp:602
msgctxt "posture"
msgid "Standing"
msgstr "Stående"

#: client/scenes/gui_settings.cpp:602
msgctxt "posture"
msgid "Seated"
msgstr "Sittande"

#: client/scenes/gui_settings.cpp:608
msgctxt "setting name"
msgid "Height adjustment"
msgstr "Höjdjustering"

#: client/scenes/gui_settings.cpp:610
msgid ""
"Corrects the height reported to the PC when seated, useful for games without"
" native seated support."
msgstr ""
"Korrigerar höjden som rapporteras till datorn när du sitter. Användbart för "
"spel som saknar stöd för sittande spelande."

#: client/scenes/gui_settings.cpp:611
msgid ""
"Corrects the height reported to the PC when standing, useful for a "
"miscalibrated floor."
msgstr ""
"Korrigerar höjden som rapporteras till datorn när du står. Användbart om "
"golvnivån är felkalibrerad."

#: client/scenes/gui_settings.cpp:636
msgctxt "setting name"
msgid "Hand tracking"
msgstr "Handspårning"

#: client/scenes/gui_settings.cpp:636
msgid "Track your hands for input when controllers are down."
msgstr ""
"Använd dina händers rörelser för inmatning när du lagt ifrån dig "
"handkontrollerna."

#: client/scenes/gui_settings.cpp:639
msgctxt "setting name"
msgid "Eye tracking"
msgstr "Ögonspårning"

#: client/scenes/gui_settings.cpp:639
msgid "Used by foveated encoding to focus quality where you look."
msgstr ""
"Används av foveerad kodning för att koncentrera bildkvaliteten till området "
"du tittar på."

#: client/scenes/gui_settings.cpp:642
msgctxt "setting name"
msgid "Face tracking"
msgstr "Ansiktsspårning"

#: client/scenes/gui_settings.cpp:642
msgid "Stream facial expressions to the PC."
msgstr "Strömma ansiktsuttryck till datorn."

#: client/scenes/gui_settings.cpp:650
msgctxt "virtual body tracker selection"
msgid "Chest"
msgstr "Bröst"

#: client/scenes/gui_settings.cpp:651
msgctxt "virtual body tracker selection"
msgid "Left elbow"
msgstr "Vänster armbåge"

#: client/scenes/gui_settings.cpp:652
msgctxt "virtual body tracker selection"
msgid "Right elbow"
msgstr "Höger armbåge"

#: client/scenes/gui_settings.cpp:653
msgctxt "virtual body tracker selection"
msgid "Hip"
msgstr "Höft"

#: client/scenes/gui_settings.cpp:654
msgctxt "virtual body tracker selection"
msgid "Left knee"
msgstr "Vänster knä"

#: client/scenes/gui_settings.cpp:655
msgctxt "virtual body tracker selection"
msgid "Right knee"
msgstr "Höger knä"

#: client/scenes/gui_settings.cpp:656
msgctxt "virtual body tracker selection"
msgid "Left foot"
msgstr "Vänster fot"

#: client/scenes/gui_settings.cpp:657
msgctxt "virtual body tracker selection"
msgid "Right foot"
msgstr "Höger fot"

#: client/scenes/gui_settings.cpp:672
msgctxt "setting name"
msgid "Body tracking"
msgstr "Kroppsspårning"

#: client/scenes/gui_settings.cpp:674
msgid ""
"Requires 'Hand and body tracking' to be enabled in the Quest movement "
"tracking settings, otherwise body data will be guessed from controller and "
"headset positions."
msgstr ""
"Kräver att ”Hand and body tracking” är aktiverat i Quests inställningar för "
"rörelsespårning. Annars uppskattas kroppspositionerna utifrån "
"handkontrollernas och headsetets positioner."

#: client/scenes/gui_settings.cpp:675
msgid "Stream body joint positions to the PC."
msgstr "Strömma ledernas positioner till datorn."

#: client/scenes/gui_settings.cpp:686 client/scenes/gui_settings.cpp:701
msgctxt "setting name"
msgid "Virtual body trackers"
msgstr "Virtuella kroppsspårare"

#: client/scenes/gui_settings.cpp:687
msgid "Create virtual tracker devices."
msgstr "Skapa virtuella spårningsenheter."

#: client/scenes/gui_settings.cpp:707
msgctxt "page header title"
msgid "Tracking"
msgstr "Spårning"

#: client/scenes/gui_settings.cpp:707
msgctxt "page header subtitle"
msgid "Body and input tracking sent to the PC."
msgstr "Spårning av kropp och inmatningsenheter som skickas till datorn."

#: client/scenes/gui_settings.cpp:721
msgctxt "language selection, replace with the name of the language"
msgid "English"
msgstr "Svenska"

#: client/scenes/gui_settings.cpp:744 client/scenes/gui_settings.cpp:758
msgid "Language"
msgstr "Språk"

#: client/scenes/gui_settings.cpp:745
msgctxt "setting name"
msgid "Interface language."
msgstr "Gränssnittets språk."

#: client/scenes/gui_settings.cpp:754
msgctxt "item in the interface language combobox"
msgid "System language"
msgstr "Systemspråk"

#: client/scenes/gui_settings.cpp:766
msgctxt "setting name"
msgid "USB networking"
msgstr "Nätverk via USB"

#: client/scenes/gui_settings.cpp:767
msgid ""
"Enables connection by USB without ADB or developer mode.\n"
"Make sure the server allows IPv6 link-local only connections."
msgstr ""
"Möjliggör anslutning via USB utan ADB eller utvecklarläge.\n"
"Kontrollera att servern tillåter anslutningar med enbart länklokala IPv6-adresser."

#: client/scenes/gui_settings.cpp:777
msgctxt "setting name"
msgid "Extended configuration"
msgstr "Utökade inställningar"

#: client/scenes/gui_settings.cpp:778
msgid "Allows unsafe configuration values, use at your own risk."
msgstr "Tillåter osäkra inställningsvärden. Använd på egen risk."

#: client/scenes/gui_settings.cpp:789
msgid "High power mode"
msgstr "Högeffektläge"

#: client/scenes/gui_settings.cpp:790
msgid ""
"Increase power usage to allow higher resolution and refresh rate. Drains "
"battery and runs hot."
msgstr ""
"Ökar strömförbrukningen för att möjliggöra högre upplösning och "
"uppdateringsfrekvens. Förbrukar mer batteri och utvecklar mer värme."

#: client/scenes/gui_settings.cpp:802
msgctxt "setting name"
msgid "Enable boundary in passthrough"
msgstr "Visa spelområdets gräns vid genomsyn"

#: client/scenes/gui_settings.cpp:803
msgid ""
"Shows the boundary while passthrough is on. Disable to walk freely outside "
"of it. The boundary is always shown in VR."
msgstr ""
"Visar spelområdets gräns när genomsyn är på. Inaktivera för att kunna gå "
"fritt utanför området. Gränsen visas alltid i VR."

#: client/scenes/gui_settings.cpp:815
msgctxt "setting name"
msgid "In-stream window"
msgstr "Fönster under strömning"

#: client/scenes/gui_settings.cpp:816
msgid ""
"Enables the configuration window to be shown while the game is streaming. If"
" enabled, the window is activated by pressing both thumbsticks."
msgstr ""
"Gör det möjligt att visa inställningsfönstret medan spelet strömmas. När "
"detta är aktiverat öppnas fönstret genom att trycka ned båda styrspakarna."

