msgctxt "setting name"
msgid "Accent color"
msgstr "強調色"

#: client/scenes/gui_settings.cpp:888
msgctxt "setting name"
msgid "Preset"
msgstr "預設集"

#: client/scenes/gui_settings.cpp:888
msgctxt "setting description"
msgid "Surface and background palette"
msgstr "表面與背景配色"

#: client/scenes/gui_settings.cpp:889
msgid "Theme preset"
msgstr "主題預設集"

#: client/scenes/gui_settings.cpp:908
msgctxt "setting label"
msgid "Rounding"
msgstr "圓角"

#: client/scenes/gui_settings.cpp:908
msgctxt "setting description"
msgid "Corner radius of controls"
msgstr "控制項的圓角半徑"

#: client/scenes/gui_settings.cpp:920
msgctxt "setting label"
msgid "Card rounding"
msgstr "卡片圓角"

#: client/scenes/gui_settings.cpp:920
msgctxt "setting description"
msgid "Corner radius of panels"
msgstr "面板的圓角半徑"

#: client/scenes/gui_settings.cpp:933
msgctxt "setting name"
msgid "Text size"
msgstr "文字大小"

#: client/scenes/gui_settings.cpp:933
msgctxt "setting description"
msgid "Global font scale"
msgstr "整體字型縮放"

#: client/scenes/gui_settings.cpp:946
msgctxt "setting name"
msgid "Panel opacity"
msgstr "面板不透明度"

#: client/scenes/gui_settings.cpp:946
msgctxt "setting description"
msgid "Opacity of the panel and card backgrounds"
msgstr "面板與卡片背景的不透明度"

#: client/scenes/lobby.cpp:232
msgid "Incompatible WiVRn server: no protocol field in TXT"
msgstr "不相容的 WiVRn 伺服器: TXT 中沒有協議欄位"

#: client/scenes/lobby.cpp:235
msgid "Incompatible WiVRn server protocol (client: {}, server: {})"
msgstr "不相容的 WiVRn 伺服器協議（用戶端: {}，伺服器: {}）"

